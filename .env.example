# Shared local configuration for both submodules.
# Copy this file to .env (git-ignored) and fill in the real values.

# --- Backend (petit-caillou-service), consumed by application.yml ---
# JDK 21 home used to run the service (mvnw). Example on macOS:
#   /Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home
JAVA_HOME=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=petit_caillou
DB_USERNAME=petit_caillou
DB_PASSWORD=

# TLS to the database: disable | trust | verify-ca | verify-full.
# For any remote host use verify-full (or at least trust): anything lower
# sends the password in clear over the network.
DB_SSL_MODE=verify-full

SERVER_PORT=8080

# --- Frontend (petit-caillou-web) ---
# The browser reaches the API on the same origin through the Vite dev proxy
# (/api -> backend), so this stays "/api" in local development.
VITE_API_URL=/api
